programa {
  funcao inicio() {
    real valor
    real quantia
    escreva("Digite o valor de depósito: \n")
    leia(valor)

    quantia = (valor*0.05+valor)
    escreva("Após 1 mês, sua quantia será: ",quantia)
    
    // José Guilherme
    // 1° ano C
    // Disciplina: Lógica de programação
    // Data: 16/09/2026

     
  }
}
