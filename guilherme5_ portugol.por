programa {
  funcao inicio() {

    inteiro salario
    real novosalario
     escreva("Digite o salário atual: \n")
     leia(salario)

     novosalario = (salario * 0.15 + salario)
         escreva("O novo salário é: ", novosalario)

         // Aluno: José Guilherme
         // Disciplina: Lógica de programação
         // Data: 16/09/2026


  }
}
