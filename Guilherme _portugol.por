programa {
  funcao inicio() {
    inteiro n1
    inteiro n2
    real valor

    escreva("Digite o número 1: \n")
    leia(n1)
    escreva("Digite o número 2: \n")
    leia(n2)

    valor =(n1*n1 + n2*n2)

    escreva("A soma do quadrado desses dois números é: ", valor)

    // Aluno: José Guilherme
    // Disciplina: Lógica de programação
    // 1° C
    // Data: 16/09/2026



    
  }
}
