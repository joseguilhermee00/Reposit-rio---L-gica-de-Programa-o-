programa {
  funcao inicio() {
    real altura
    real pesoideal

    escreva("Digite sua altura: \n")
    leia(altura)

    pesoideal = (72.7 * altura) - 58

    escreva("O peso ideal é: ",pesoideal)

    // Aluno: José Guilherme
    // Disciplina: Lógica de programação
    // Data: 16/09/2026
  }
}
