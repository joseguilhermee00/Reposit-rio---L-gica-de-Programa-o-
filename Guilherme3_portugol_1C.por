programa {
  funcao inicio() {
    inteiro valor, hora, total

    escreva("Digite o valor da hora do funcionário: \n")
    leia(valor)
    escreva("Digite a hora trabalhada no mês: \n")
    leia(hora)

    total = (valor * hora)
    escreva("O salário do funcionário é: ", total)

    // Aluno: José Guilherme
    // Disciplina: Lógica de programação
    // Data: 16/09/2026
    // 1° ano C


  }
}
